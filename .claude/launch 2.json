{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vite (frontend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5174
    },
    {
      "name": "Web Audit worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "workers/web-audit"],
      "port": 8787
    },
    {
      "name": "Supabase local stack",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["supabase", "start"],
      "port": 54321
    },
    {
      "name": "Supabase functions serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["supabase", "functions", "serve"],
      "port": 54321
    }
  ]
}
