{
  "crons": [
    {
      "path": "/api/cron/process-scheduled-payments",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/process-scheduled-client-invoices",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|manifest\\.json|favicon|sw\\.js|workbox-|api/).*)",
      "destination": "/index.html"
    }
  ]
}
